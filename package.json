{
  "name": "bedrock-cost-controls",
  "version": "1.0.0",
  "description": "A Lambda gateway in front of Amazon Bedrock Converse that enforces per-user daily token budgets in DynamoDB, routes between a cheap and a capable model, uses prompt caching and emits token metrics. AWS CDK, TypeScript.",
  "private": true,
  "license": "MIT-0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint .",
    "bundle": "ts-node scripts/bundle.ts",
    "test": "npm run bundle && jest",
    "test:int": "jest -c jest.integration.config.js",
    "synth": "cdk synth --quiet -c alertEmail=alerts@example.com",
    "check": "npm run build && npm run lint && npm test && npm run synth",
    "deploy": "npm run bundle && cdk deploy",
    "destroy": "cdk destroy",
    "cost": "ts-node scripts/cost-model.ts",
    "smoke": "ts-node scripts/smoke-test.ts",
    "mutate": "ts-node scripts/mutation-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1152.0",
    "@aws-sdk/client-dynamodb": "^3.1152.0",
    "@aws-sdk/lib-dynamodb": "^3.1152.0",
    "aws-cdk-lib": "^2.273.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1152.0",
    "@aws-sdk/client-lambda": "^3.1152.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "aws-cdk": "^2.1145.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.0"
  }
}
